{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoutineRuns",
  "description": "Execution history of routines.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "routine_id", "status", "session_key", "started_at"],
    "properties": {
      "id": { "type": "string" },
      "routine_id": { "type": "string" },
      "status": {
        "type": "string",
        "enum": ["running", "silent", "surfaced", "error", "cancelled"]
      },
      "session_key": { "type": "string" },
      "activity_id": { "type": "string" },
      "summary": { "type": "string" },
      "started_at": { "type": "string", "format": "date-time" },
      "completed_at": { "type": "string", "format": "date-time" },
      "paused_until": {
        "type": "string",
        "description": "Human-readable reset hint while the provider CLI is sleeping on a usage-limit window. Only meaningful when status is 'running'."
      },
      "failure": {
        "type": "object",
        "required": ["code", "provider"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "creator_not_connected",
              "team_not_connected",
              "creator_needs_reconnect",
              "team_needs_reconnect",
              "out_of_credits",
              "model_unavailable"
            ]
          },
          "provider": { "type": "string" }
        },
        "additionalProperties": false
      },
      "delivery_failure": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string",
            "enum": ["pool_delivery_expired"]
          }
        },
        "additionalProperties": false
      },
      "resumed": {
        "type": "boolean",
        "const": true
      }
    },
    "additionalProperties": false
  }
}
