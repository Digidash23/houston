{# Behaviours that are this page's own. The shared chrome (language menu,
   mobile sheet, download gate) is bound by landing/subpage-scripts.njk, which
   the layout includes first. Everything here is enhancement: with JS off the
   page stands complete, every tile in color and every number final. #}
<script>
  // Nav scroll state, the landing's rule: transparent over the hero, frosted
  // once scrolled, black over dark grounds and white over light ones. The
  // dark grounds are read live, because the page's tone flow
  // (assets/enterprise-flow.js) turns sections dark and light as you go, and
  // the bar follows it the moment it turns.
  (function () {
    var nav = document.getElementById("lnav");
    if (!nav) return;
    function check() {
      var y = 34; // the bar's vertical middle
      var darks = document.querySelectorAll(".hero, .section.is-dark, .lfoot");
      var overDark = Array.prototype.some.call(darks, function (el) {
        var r = el.getBoundingClientRect();
        return r.top <= y && r.bottom >= y;
      });
      nav.classList.toggle("scrolled", window.scrollY > 10);
      nav.classList.toggle("on-light", !overDark);
    }
    window.addEventListener("scroll", check, { passive: true });
    window.addEventListener("resize", check);
    document.addEventListener("ent:tone", check);
    check();
  })();

  // Scroll reveals (landing-motion.css owns the transition; this only marks
  // what has come into view). No observer, no hiding: reveal everything.
  (function () {
    var nodes = document.querySelectorAll(".reveal");
    if (!("IntersectionObserver" in window)) {
      nodes.forEach(function (n) {
        n.classList.add("visible");
      });
      return;
    }
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("visible");
          io.unobserve(entry.target);
        });
      },
      { rootMargin: "0px 0px -6% 0px" }
    );
    nodes.forEach(function (n) {
      io.observe(n);
    });
  })();

  // Who trusts us: each number counts up once, when it comes into view. The
  // markup holds the final value, so reduced motion simply never starts.
  (function () {
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var nodes = document.querySelectorAll("[data-count-to]");
    if (reduce || !nodes.length || !("IntersectionObserver" in window)) return;
    var DURATION = 1600;
    // Always group: Spanish leaves four-digit numbers ungrouped by default, so
    // the count would run "4437" and then snap to the settled "5.000".
    var format;
    try {
      format = new Intl.NumberFormat(document.documentElement.lang || "en", {
        useGrouping: "always",
      });
    } catch (e) {
      return; // No such option here: keep the settled numbers.
    }

    function run(node) {
      var settled = node.textContent;
      var to = Number(node.getAttribute("data-count-to"));
      // Everything before the first digit ("+") rides along unchanged.
      var prefix = settled.replace(/\d[\s\S]*$/, "");
      var start = performance.now();
      function step(now) {
        var k = Math.min(1, Math.max(0, (now - start) / DURATION));
        if (k === 1) {
          node.textContent = settled;
          return;
        }
        var eased = 1 - Math.pow(1 - k, 3);
        node.textContent = prefix + format.format(Math.round(to * eased));
        requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          io.unobserve(entry.target);
          run(entry.target);
        });
      },
      { threshold: 0.6 }
    );
    nodes.forEach(function (n) {
      io.observe(n);
    });
  })();
</script>
