{%- set e = t.enterprise -%}
{# The landing's #multiplayer structure: one big title, then a split with two
   big phrases on the left (the second one strong) and the six industries on
   the right, as examples. Names only on the tiles; nobody reads small print
   here. Each tile is an abstract field in its industry's colors
   (.ent-aura, enterprise-aura.css), decoration only. #}
<section class="section ent-section" id="industries" data-tone="light" aria-labelledby="ent-ind-label">
  <div class="mp-head reveal">
    <h2 class="sec-title" id="ent-ind-label">{{ e.hero.industriesLabel }}</h2>
  </div>
  <div class="mp-split reveal reveal-d1">
    <div class="mp-phrases">
      <p class="mp-phrase">{{ e.hero.industriesPhrases[0] }}</p>
      <p class="mp-phrase is-strong">{{ e.hero.industriesPhrases[1] }}</p>
    </div>
    <div class="ent-tiles" id="ent-tiles">
{%- for ind in enterprise.industries %}{% set copy = e.hero.industries[loop.index0] %}
      <div class="ent-tile">
        <i class="ent-aura" data-aura="{{ ind.id }}" aria-hidden="true"></i>
        <h3 class="ent-tile-cap">{{ copy.name }}</h3>
      </div>
{%- endfor %}
    </div>
  </div>
</section>
