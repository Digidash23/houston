{%- set e = t.enterprise -%}
{# The problem, on the black band, in the landing's #parallel structure: the
   visual left (four reasons, each an abstract tile and a few big words), the
   title and two lines right. The tiles are the industries' fields drained
   to black and white, one dim light each (enterprise-aura.css). Order
   matches e.problem.cards. #}
<section id="problem" class="section is-dark ent-section" data-tone="dark">
  <div class="split reveal">
    <div class="split-visual ent-cards">
{%- for card in e.problem.cards %}
      <div class="ent-tile ent-tile-square">
        <i class="ent-aura" data-aura="{{ enterprise.problems[loop.index0] }}" aria-hidden="true"></i>
        <h3 class="ent-tile-cap">{{ card.title }}</h3>
      </div>
{%- endfor %}
    </div>
    <div class="split-copy">
      <h2 class="sec-title">{{ e.problem.title }}</h2>
      <p class="split-line">{{ e.problem.phrases[0] }}</p>
      <p class="split-line is-strong">{{ e.problem.phrases[1] }}</p>
    </div>
  </div>
</section>
